{
  "manifest_version": 3,
  "name": "AudioCopilot",
  "version": "1.0.0",
  "description": "AudioCopilot — AI Music & Remix Assistant for Suno AI & DAWs (FL Studio)",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open AudioCopilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}